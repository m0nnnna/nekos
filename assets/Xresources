xterm*color1:  #FF6B7A
xterm*color2:  #8FE3B0
xterm*color3:  #FFD98F
xterm*color4:  #6AA0E8
xterm*color5:  #FF8FB1
xterm*color6:  #7CD9D9
xterm*color7:  #EDEAF5
xterm*color8:  #4A4459
xterm*color9:  #FF97A4
xterm*color10: #ABF0C6
xterm*color11: #FFE6B0
xterm*color12: #96C4F0

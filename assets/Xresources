! nekOS terminal palette -- mirrors common/theme.h so xterm (the only
! terminal app nekOS ships) reads as part of the same visual system instead
! of X's stock black-on-white. Merged into the X server once per session by
! start-session.sh via `xrdb -merge`; scoped to `xterm*` since nothing else
! in nekOS reads core X resources (GTK/Chromium ignore these).

xterm*background: #15121C
xterm*foreground: #EDEAF5
xterm*cursorColor: #FF8FB1
xterm*internalBorder: 8
xterm*scrollBar: false

! Standard 16-color ANSI palette, tuned to theme.h's accents (0-7 normal,
! 8-15 bright variants).
